{% if interface["description"] | length > 1 %}
set interfaces {{ interface["name"] }} unit 0 description "{{ interface["description"] }}"
{% endif %}
{% for addr in interface["ip_addresses"] %}
set interfaces {{ interface["name"] }} unit 0 family inet address {{ addr["address"] }}
{% endfor %}
{% if interface["enabled"] == false %}
set interfaces {{ interface["name"] }} disable
{% endif %}

{% if ospf_state.router_id %}
set routing-options router-id {{ ospf_state.router_id }}
{% endif %}
{% if config_context["ospf"].get("reference_bandwidth") %}
{% set ref_bw = config_context["ospf"]["reference_bandwidth"] %}
set protocols ospf reference-bandwidth {{ (ref_bw // 1000) ~ "g" if ref_bw % 1000 == 0 else ref_bw ~ "m" }}
{% endif %}
{% for name in ospf_state.interfaces %}
{% if name.startswith("lo") %}
set protocols ospf area {{ ospf_state.area }} interface {{ name }}.0 passive
{% else %}
set protocols ospf area {{ ospf_state.area }} interface {{ name }}.0 interface-type p2p
{% endif %}
{% endfor %}

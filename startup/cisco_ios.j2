!
subscriber templating
!
multilink bundle-name authenticated
!
diagnostic bootup level minimal
archive
 path bootflash:archive
memory free low-watermark processor 72107
file prompt quiet
!
!
spanning-tree extend system-id
!
{% include './startup/ios/users.j2' %}
!
redundancy
!
{% if config_context["lldp"] == true %}
lldp run
{% endif %}
{% if config_context["cdp"] == true %}
cdp run
{% endif %}
!
{% for interface in interfaces if interface["name"] == "Loopback99" %}
{% include './ios/_loopback.j2' %}
!
{% endfor %}
{% for interface in interfaces if interface["name"].startswith("GigabitEthernet") %}
{% if interface["mgmt_only"] %}
{% include './ios/_physical.j2' %}
{% else %}
interface {{ interface["name"] }}
 no ip address
{% if interface["enabled"] == false %}
 shutdown
{% endif %}
 negotiation auto
 no mop enabled
 no mop sysid
!
{% endif %}
{% endfor %}
!
virtual-service csr_mgmt
!
ip forward-protocol nd
no ip http server
ip http authentication local
no ip http secure-server
!
{% include './ios/mgmt_route.j2' %}
ip scp server enable
!
control-plane
!
alias exec ntcclear clear platform software vnic-if nv
!
{% include './ios/console_vty.j2' %}
!
{% include './ios/services.j2' %}
end

{# Startup config: what a containerlab device boots with and is reset to. Data ports are bare;
   their addresses, OSPF and services come from the main template as change config. The
   self-signed certificate and license lines are left out: they are unique to each device. #}
{% set ospf_state = namespace(enabled=false, router_id=none, process_id=none, area=none, interfaces=[]) %}
{% set mgmt_state = namespace(interface=none, vrf=none) %}
{% include './common/mgmt_state.j2' %}
{% set startup_state = namespace(username=none, password=none) %}
{% include './startup/common/startup_state.j2' %}
!
service timestamps debug datetime msec
service timestamps log datetime msec
! Call-home is enabled by Smart-Licensing.
service call-home
platform qfp utilization monitor load 80
platform punt-keepalive disable-kernel-core
platform console serial
!
{% include './ios/hostname.j2' %}
!
boot-start-marker
boot-end-marker
!
!
!
{% if config_context["aaa-new-model"] == false %}
no aaa new-model
{% else %}
aaa new-model
{% endif %}
{% include "./ios/call_home.j2" %}
!
login on-success log
!

{% set dns = config_context.get("dns", {}) %}
{% if mgmt_state.interface %}
ip domain lookup source-interface {{ mgmt_state.interface }}
{% endif %}
{% for name_server in dns.get("name_servers", []) %}
ip name-server vrf default {{ name_server }}
{% endfor %}
dns domain {{ dns.get("domain", "infra.ntc.com") }}

